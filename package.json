{
	"name": "tree-sitter-ldif",
	"version": "0.1.0",
	"description": "Tree-sitter grammar for LDIF (LDAP Data Interchange Format, RFC 2849)",
	"keywords": [
		"parser",
		"tree-sitter",
		"ldif",
		"ldap"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kjanat/tree-sitter-ldif.git"
	},
	"license": "MIT",
	"type": "module",
	"main": "bindings/node",
	"types": "bindings/node",
	"files": [
		"grammar.js",
		"tree-sitter.json",
		"binding.gyp",
		"prebuilds/**",
		"bindings/node/*",
		"queries/*",
		"src/**",
		"*.wasm"
	],
	"scripts": {
		"fmt": "dprint fmt",
		"generate": "tree-sitter generate",
		"helix:sync": "mkdir -p ~/.config/helix/runtime/queries/ldif && cp queries/*.scm ~/.config/helix/runtime/queries/ldif/",
		"install": "node-gyp-build",
		"prestart": "tree-sitter build --wasm",
		"start": "tree-sitter playground --quiet",
		"test": "tree-sitter test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"node-addon-api": "^8.6.0",
		"node-gyp-build": "^4.8.4"
	},
	"devDependencies": {
		"dprint": "^0.53.0",
		"prebuildify": "^6.0.1",
		"tree-sitter": "^0.25.0",
		"tree-sitter-cli": "^0.26.7",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"tree-sitter": "^0.25.0"
	},
	"peerDependenciesMeta": {
		"tree-sitter": {
			"optional": true
		}
	},
	"packageManager": "bun@1.3.11"
}
